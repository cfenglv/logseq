{
  "name": "selfhost-sync",
  "main": "dist/worker/main.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGSEQ_SYNC_DO",
        "class_name": "SyncDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncDO"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOGSEQ_SYNC_ASSETS",
      "bucket_name": "selfhost-sync-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selfhost-sync-meta",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "COGNITO_ISSUER": "https://cognito-idp.example.invalid/example",
    "COGNITO_CLIENT_ID": "example-client-id",
    "COGNITO_JWKS_URL": "https://cognito-idp.example.invalid/example/.well-known/jwks.json"
  }
}
