{:deps {org.babashka/http-server {:mvn/version "0.1.14"}
        org.babashka/cli {:mvn/version "0.8.67"}}
 :tasks
 {:requires ([babashka.cli :as cli])
  :init (do
          (def cli-opts (cli/parse-opts *command-line-args* {:alias {:p :port :n :namespace :i :include :v :var}
                                                             :coerce {:port :int :headers :edn}}))
          (defn clojure-with-port
            [cmd]
            (if-let [port (:port cli-opts)]
              (str "-J-Dport=" port " " cmd)
              cmd))
          (defn rtc-test-command
            [test-namespace]
            (if-let [test-var (:var cli-opts)]
              (str "-Srepro -M:test -v " test-var)
              (str "-Srepro -M:test -n " test-namespace))))

  serve {:doc "Serve static assets"
         :requires ([babashka.http-server :as server])
         :task (server/exec (merge {:port 3002
                                    :dir "../static/"}
                                   cli-opts))}

  ;; Keep argument diagnostics in-process. Starting a second Clojure CLI in
  ;; parallel with the test task races git dependency checkouts in ~/.gitlibs
  ;; on clean machines and CI runners.
  prn {:task (clojure.core/prn cli-opts)}

  test {:doc "run tests (ns'es ending in '-basic-test'); use -n <ns> to run a single namespace, -v <ns/fn> to run a single test fn, -i <tag> to filter by metadata"
        :task (do (let [ns      (:namespace cli-opts)
                        include (:include cli-opts)
                        var     (:var cli-opts)
                        ns-arg  (when ns (str " -n " ns))
                        inc-arg (when include (str " -i " include))
                        var-arg (when var (str " -v " var))
                        base    (if ns
                                  (str "-Srepro -M:test" ns-arg " -e fix-me")
                                  "-Srepro -M:test -r \".*\\-basic\\-test$\" -e fix-me")]
                    (clojure (clojure-with-port (str base inc-arg var-arg))))
                  (System/exit 0))}

  rtc-extra-test {:doc "run rtc-extra-test"
                  :task (do (clojure (clojure-with-port
                                      (rtc-test-command "logseq.e2e.rtc-extra-test")))
                            (System/exit 0))}

  rtc-extra-part2-test {:doc "run rtc-extra-part2-test"
                        :task (do (clojure (clojure-with-port
                                            (rtc-test-command "logseq.e2e.rtc-extra-part2-test")))
                                  (System/exit 0))}

  ;; Allocate an isolated port and own the asset-server lifecycle explicitly.
  ;; This keeps interrupted or repeated E2E runs from leaking a fixed-port
  ;; server into the next local gate or CI job.
  run-rtc-extra-test
  {:task (shell "node" "../scripts/run-rtc-e2e.mjs" "rtc-extra-test")}

  run-rtc-extra-part2-test
  {:task (shell "node" "../scripts/run-rtc-e2e.mjs" "rtc-extra-part2-test")}

  -dev {:depends [serve prn test]}

  dev {:doc "serve and test"
       :task (run '-dev {:parallel true})}}}
